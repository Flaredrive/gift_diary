<div class="col-md-8 mx-auto">
  <h1>ランキング</h1>
  <div class="row">
    <% @posts.each do |post| %>
      <div class="col-12 col-sm-6 col-md-4 mb-4">
        <div class="card h-100">
          <%= image_tag url_for(post.image), class: "card-img-top", size: "200x200" %>
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to post.name, post_path(post) %>
            </h5>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
