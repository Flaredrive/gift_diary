<h2><%= @post.name %></h2>

<div class="d-flex align-items-start gap-3">
  <%= image_tag url_for(@post.image), size: "200x200" %>

  <div class="d-flex flex-column align-items-start ">
    <div class="mb-5">
      投稿したユーザー：
      <%= link_to @post.user.name, user_path(@post.user) %>
    </div>

    <% if authenticated? && @user == Current.user %>
      <%= link_to "ポスト編集", edit_post_path(@post) %>
      <%= link_to "ポスト削除", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
    <% end %>
  </div>
</div>