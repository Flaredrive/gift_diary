<div class="container">
  <div class="row">
    <div class="col-8 mx-auto">
      <div class="mx-auto" style="width: 80%;">
      <%= form_with model: Post.new do |f| %>
        <h4>商品名</h4>
        <%= f.text_field :name %>

        <h4>商品画像</h4>
        <%= f.file_field :image, accept: "image/*" %>

        <%= f.submit '投稿' %>
      <% end %>
    </div>
  </div>
</div>