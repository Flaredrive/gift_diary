<div class="container">
  <div class="row">
    <div class="col-6 mx-auto">
      <div class="mx-auto">
        <%= form_with model: @user do |f| %>
          <h4>名前</h4>
          <%= f.text_field :name %>

          <h4>アイコン</h4>
          <%= f.file_field :image, accept: "image/*" %>
  
          <h4>メールアドレス</h4>
          <%= f.text_field :email_address %>
  
          <%= f.submit '保存' %>
  
        <% end %>
      </div>
    </div>
  </div>
</div>